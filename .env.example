# ==========================================
# Portfolio Contact Form Email Configuration
# ==========================================

# 1. Receiver Email (Required)
# The destination email address where contact transmissions will be delivered.
# Must be configured locally in .env.local and in your Vercel Project Settings.
CONTACT_RECEIVER_EMAIL=your-email@example.com

# 2. Resend API Key (Required)
# API key from your Resend account: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 3. Sender Email (Optional)
# If omitted, defaults to: Portfolio Contact <onboarding@resend.dev>
# When using onboarding@resend.dev, Resend permits sending only to your verified account email.
# To send to any recipient or use a custom domain, verify your domain in Resend.
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
